{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtrisBridge",
  "version": "0.1.0-alpha.9",
  "identifier": "com.atrishub.atrisbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AtrisBridge",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "publisher": "AtrisHub",
    "copyright": "Copyright © 2026 AtrisHub"
  }
}
