{
  "name": "atrisbridge",
  "private": true,
  "version": "0.1.0-alpha.8",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sidecar:prepare": "node scripts/prepare-rclone.mjs",
    "sidecar:prepare:release": "node scripts/prepare-release-rclone.mjs",
    "sidecar:verify:release": "node scripts/verify-release-rclone.mjs",
    "icons:prepare": "tauri icon src-tauri/icons/icon.png",
    "test:release-contract": "node --test .github/scripts/release-contract.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run sidecar:prepare:release && npm run icons:prepare && node .github/scripts/create-package-build-config.mjs src-tauri/tauri.package.conf.json && tauri build --config src-tauri/tauri.package.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
